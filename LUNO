-- HUD Behavior
----------------------------------------------------------------

local LogHistory = {}

function HUD.Log(message)
	local timestamp = string.format("[%05.2f]", os.clock() % 100)
	table.insert(LogHistory, timestamp .. " " .. tostring(message))
	if #LogHistory > 6 then
		table.remove(LogHistory, 1)
	end
	ConsoleText.Text = table.concat(LogHistory, "\n")
end

function HUD.FadeIn()
	local tweenInfo = TweenInfo.new(0.35)
	TweenService:Create(MainHUD, tweenInfo, { BackgroundTransparency = 0 }):Play()
	TweenService:Create(HUDStroke, tweenInfo, { Transparency = 0.3 }):Play()
	TweenService:Create(BrandTitle, tweenInfo, { TextTransparency = 0 }):Play()
	TweenService:Create(StatusLED, tweenInfo, { BackgroundTransparency = 0 }):Play()
	TweenService:Create(SysStatusLbl, tweenInfo, { TextTransparency = 0 }):Play()
	TweenService:Create(TerminalFrame, tweenInfo, { BackgroundTransparency = 0 }):Play()
	TweenService:Create(TermStroke, tweenInfo, { Transparency = 0 }):Play()
	TweenService:Create(ConsoleText, tweenInfo, { TextTransparency = 0 }):Play()
	TweenService:Create(MeterTrack, tweenInfo, { BackgroundTransparency = 0 }):Play()
	TweenService:Create(ProgressPercent, tweenInfo, { TextTransparency = 0 }):Play()
	TweenService:Create(ProgressStatus, tweenInfo, { TextTransparency = 0 }):Play()
	task.wait(0.35)
end

function HUD.Update(targetPercent, statusTag, logMessage)
	if logMessage then
		HUD.Log(logMessage)
	end
	ProgressStatus.Text = statusTag
	ProgressPercent.Text = tostring(math.floor(targetPercent * 100)) .. "%"
	TweenService:Create(
		MeterFill,
		TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{ Size = UDim2.new(targetPercent, 0, 1, 0) }
	):Play()
	task.wait(0.28)
end

function HUD.FadeOut()
	local tweenInfo = TweenInfo.new(0.35)
	TweenService:Create(MainHUD, tweenInfo, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(HUDStroke, tweenInfo, { Transparency = 1 }):Play()
	TweenService:Create(BrandTitle, tweenInfo, { TextTransparency = 1 }):Play()
	TweenService:Create(StatusLED, tweenInfo, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(SysStatusLbl, tweenInfo, { TextTransparency = 1 }):Play()
	TweenService:Create(TerminalFrame, tweenInfo, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(TermStroke, tweenInfo, { Transparency = 1 }):Play()
	TweenService:Create(ConsoleText, tweenInfo, { TextTransparency = 1 }):Play()
	TweenService:Create(MeterTrack, tweenInfo, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(MeterFill, tweenInfo, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(ProgressPercent, tweenInfo, { TextTransparency = 1 }):Play()
	TweenService:Create(ProgressStatus, tweenInfo, { TextTransparency = 1 }):Play()
	task.wait(0.35)
	LoadingGui:Destroy()
end

----------------------------------------------------------------
-- Universal Fallback Window
----------------------------------------------------------------

local function LaunchUniversalMode(LunoLibrary)
	local Window = LunoLibrary:CreateWindow({
		Title = "LUNO",
		SubTitle = "Universal",
		Discord = "https://discord.gg/lunar",
	})

	local MainTab = Window:CreateTab("Universal Mode")

	MainTab:CreateSection("System Info")
	MainTab:CreateButton({
		Title = "LUNO Universal Engine Active",
		Callback = function()
			LunoLibrary:Notify({
				Title = "Universal Mode",
				Content = "This game is not in the custom supported list.",
				Duration = 3,
			})
		end,
	})

	MainTab:CreateSection("Universal Utilities")
	MainTab:CreateButton({
		Title = "Rejoin Server",
		Callback = function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
		end,
	})
end

----------------------------------------------------------------
-- Bootstrap Sequence
----------------------------------------------------------------

task.spawn(function()
	HUD.FadeIn()

	HUD.Update(0.15, "ENV_CHECK", "ENV: Identifying Client Hardware & Level...")
	HUD.Update(0.30, "NET_CONNECT", "NET: Handshake -> GitHub Raw Repository...")

	local librarySource, libErr = Net.Get(Config.LibraryURL)
	if not librarySource then
		HUD.Update(0.50, "NET_ERROR", "ERR: Failed to fetch UI Library! (" .. tostring(libErr) .. ")")
		task.wait(2)
		HUD.FadeOut()
		return
	end

	HUD.Update(0.45, "NET_OK", "NET: Library source received (" .. tostring(#librarySource) .. " bytes)")

	local compiledLib, compileErr = loadstring(librarySource)
	if not compiledLib then
		HUD.Update(0.55, "COMPILE_ERR", "ERR: Failed to compile UI Library! (" .. tostring(compileErr) .. ")")
		task.wait(2)
		HUD.FadeOut()
		return
	end

	local runOk, LunoLibrary = pcall(compiledLib)
	if not runOk or not LunoLibrary then
		HUD.Update(0.60, "RUNTIME_ERR", "ERR: Library execution failed! (" .. tostring(LunoLibrary) .. ")")
		task.wait(2)
		HUD.FadeOut()
		return
	end

	HUD.Update(0.65, "SYS_ANALYSIS", "MATCH: Scanning Place ID [" .. tostring(PlaceId) .. "]...")

	local targetScriptURL = Config.GameModules[PlaceId]

	if targetScriptURL then
		HUD.Update(0.75, "GAME_MATCHED", "SUCCESS: Place ID Matched -> Downloading Module...")

		local gameSource, gameErr = Net.Get(targetScriptURL)

		if not gameSource then
			HUD.Log("ERR: Failed to download game module! (" .. tostring(gameErr) .. ")")
			warn("[LUNO] Failed to download game module from: " .. targetScriptURL)
			warn("[LUNO] Error: " .. tostring(gameErr))
			HUD.Update(0.85, "FALLBACK", "WARN: Falling back to Universal Mode...")
			task.wait(1.5)
			HUD.FadeOut()
			targetScriptURL = nil
		else
			HUD.Update(0.85, "COMPILING", "COMPILE: Assembling Game Module...")

			local compiledGame, compileGameErr = loadstring(gameSource)
			if not compiledGame then
				HUD.Log("ERR: Failed to compile game module!")
				warn("[LUNO] Compile Error: " .. tostring(compileGameErr))
				HUD.Update(0.90, "COMPILE_FAIL", "ERR: Module compile failed, check console (F9)")
				task.wait(2)
				HUD.FadeOut()
				return
			end

			HUD.Update(1.00, "SYSTEM_READY", "LAUNCH: Executing Game Module...")
			task.wait(0.4)
			HUD.FadeOut()

			local execOk, execErr = pcall(compiledGame)
			if not execOk then
				warn("[LUNO] Game Module Runtime Error: " .. tostring(execErr))
			end

			return
		end
	end

	if not targetScriptURL then
		HUD.Update(0.85, "NO_DIRECT_MATCH", "WARN: Place Unlisted -> Initializing Universal Kernel...")
		HUD.Update(1.00, "SYSTEM_READY", "LAUNCH: Opening Universal LUNO Window...")
		task.wait(0.4)
		HUD.FadeOut()

		LaunchUniversalMode(LunoLibrary)
	end
end)
