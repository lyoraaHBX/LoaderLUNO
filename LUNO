----------------------------------------------------------------
-- Network Layer
----------------------------------------------------------------

local Net = {}

function Net.Get(url)
	local bustedUrl = url .. "?v=" .. tostring(math.random(100000, 999999)) .. tostring(tick())

	local body, lastError

	local ok1, res1 = pcall(function()
		return game:HttpGet(bustedUrl)
	end)
	if ok1 and res1 and #res1 > 0 then
		body = res1
	else
		lastError = res1
	end

	if not body then
		local ok2, res2 = pcall(function()
			return game:HttpGetAsync(bustedUrl)
		end)
		if ok2 and res2 and #res2 > 0 then
			body = res2
		else
			lastError = res2
		end
	end

	if not body then
		local requestFn = (syn and syn.request) or http_request or request
		if requestFn then
			local ok3, res3 = pcall(function()
				local response = requestFn({ Url = bustedUrl, Method = "GET" })
				return response and response.Body
			end)
			if ok3 and res3 and #res3 > 0 then
				body = res3
			else
				lastError = res3
			end
		end
	end

	if not body then
		return nil, lastError or "Unknown HTTP error"
	end

	return body, nil
end

----------------------------------------------------------------
-- GUI Host Resolution
----------------------------------------------------------------

local function ResolveGuiParent()
	if gethui then
		return gethui()
	elseif syn and syn.protect_gui then
		local gui = Instance.new("ScreenGui")
		syn.protect_gui(gui)
		gui.Parent = CoreGui
		return gui
	elseif CoreGui:FindFirstChild("RobloxGui") then
		return CoreGui
	else
		return LocalPlayer:WaitForChild("PlayerGui")
	end
end

