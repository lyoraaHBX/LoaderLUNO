task.spawn(function()
    FadeInHUD()
    
    UpdateTerminal(0.15, "ENV_CHECK", "ENV: Identifying Client Hardware & Level...")
    UpdateTerminal(0.35, "NET_CONNECT", "NET: Handshake -> GitHub Raw Repository...")
    
    local LunoLibrary = nil
    local libSuccess, libErr = pcall(function()
        LunoLibrary = loadstring(game:HttpGet(LunoLibraryURL))()
    end)
    
    if not libSuccess or not LunoLibrary then
        UpdateTerminal(0.50, "NET_ERROR", "ERR: Failed to fetch UI Library!")
        warn("[LUNO] Library Load Error: " .. tostring(libErr))
        task.wait(2)
        FadeOutHUD()
        return
    end

    UpdateTerminal(0.65, "SYS_ANALYSIS", "MATCH: PlaceId[" .. tostring(PlaceId) .. "] / Universe[" .. tostring(UniverseId) .. "]...")
    
    local MatchedGame = FindMatchedGame()
    
    if MatchedGame then
        UpdateTerminal(0.85, "GAME_MATCHED", "SUCCESS: " .. MatchedGame.Name .. " Matched -> Loading Module...")
        UpdateTerminal(1.00, "SYSTEM_READY", "LAUNCH: Executing Game Script Assembly...")
        task.wait(0.4)
        FadeOutHUD()
        
        local scriptSuccess, scriptErr = pcall(function()
            loadstring(game:HttpGet(MatchedGame.ScriptURL))()
        end)
        
        if not scriptSuccess then
            warn("[LUNO] Game Script Error (" .. MatchedGame.Name .. "): " .. tostring(scriptErr))
        end
    else
        UpdateTerminal(0.85, "NO_DIRECT_MATCH", "WARN: Place Unlisted -> Initializing Universal Kernel...")
        
        local Window = nil
        local windowSuccess, windowErr = pcall(function()
            Window = LunoLibrary:CreateWindow({
                Title = "LUNO",
                SubTitle = "Universal",
                Discord = "https://discord.gg/lunar"
            })
        end)
        
        if not windowSuccess or not Window then
            UpdateTerminal(1.00, "UI_ERROR", "ERR: Failed to build Universal Window!")
            warn("[LUNO] CreateWindow Error: " .. tostring(windowErr))
            task.wait(2.5)
            FadeOutHUD()
            return
        end
        
        UpdateTerminal(1.00, "SYSTEM_READY", "LAUNCH: Opening Universal LUNO Window...")
        task.wait(0.4)
        FadeOutHUD()
        
        local populateSuccess, populateErr = pcall(function()
            local MainTab = Window:CreateTab("Universal Mode")

            MainTab:CreateSection("System Info")
            MainTab:CreateButton({
                Title = "LUNO Universal Engine Active",
                Callback = function()
                    LunoLibrary:Notify({
                        Title = "Universal Mode",
                        Content = "Game ini belum terdaftar di database script custom LUNO.",
                        Duration = 3
                    })
                end
            })

            MainTab:CreateSection("Supported Games")
            
            for _, gameData in ipairs(GameDatabase) do
                local teleportId = gameData.PlaceIdForTeleport or gameData.MatchValue
                
                MainTab:CreateButton({
                    Title = "🎮 " .. gameData.Name .. " — Join Game",
                    Callback = function()
                        LunoLibrary:Notify({
                            Title = "LUNO Teleport",
                            Content = "Menuju ke " .. gameData.Name .. "...",
                            Duration = 2
                        })
                        pcall(function()
                            TeleportService:Teleport(teleportId, LocalPlayer)
                        end)
                    end
                })
            end

            MainTab:CreateSection("Universal Utilities")
            MainTab:CreateButton({
                Title = "Rejoin Server",
                Callback = function()
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                    end)
                end
            })
            
            MainTab:CreateButton({
                Title = "Copy Discord Invite",
                Callback = function()
                    if setclipboard then
                        setclipboard("https://discord.gg/lunar")
                        LunoLibrary:Notify({
                            Title = "Clipboard",
                            Content = "Discord invite link copied!",
                            Duration = 2
                        })
                    end
                end
            })

            MainTab:CreateButton({
                Title = "Show Debug Info (PlaceId / UniverseId)",
                Callback = function()
                    LunoLibrary:Notify({
                        Title = "Debug Info",
                        Content = "PlaceId: " .. tostring(PlaceId) .. " | UniverseId: " .. tostring(UniverseId),
                        Duration = 5
                    })
                    print("[LUNO DEBUG] PlaceId: " .. tostring(PlaceId))
                    print("[LUNO DEBUG] UniverseId: " .. tostring(UniverseId))
                end
            })
        end)
        
        if not populateSuccess then
            warn("[LUNO] Populate Window Error: " .. tostring(populateErr))
            pcall(function()
                LunoLibrary:Notify({
                    Title = "LUNO Error",
                    Content = "Terjadi error saat memuat UI. Cek console (F9).",
                    Duration = 5
                })
            end)
        end
    end
end)
