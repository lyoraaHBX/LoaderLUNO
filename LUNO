local LogHistory = {}

local function AddConsoleLog(msg)
    local timestamp = string.format("[%05.2f]", os.clock() % 100)
    table.insert(LogHistory, timestamp .. " " .. msg)
    if #LogHistory > 6 then
        table.remove(LogHistory, 1)
    end
    ConsoleText.Text = table.concat(LogHistory, "\n")
end

